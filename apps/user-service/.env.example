 ========================================
# CONFIGURATION FILE PATHS
# ========================================
# Пути к YAML конфигурационным файлам сервиса
GRPC_SERVER_CONFIG_ADDRESS_STRING="path/to/your/grpcServerConfig.yml"
RABBITMQ_CONFIG_ADDRESS_STRING="path/to/your/rabbitMQConfig.yml"
EVENT_PUBLISHER_CONFIG_ADDRESS_STRING="path/to/your/eventPublisherConfig.yml"
OUTBOX_RELAY_CONFIG_ADDRESS_STRING="path/to/your/outboxConfig.yml"

# ========================================
# ENVIRONMENT
# ========================================
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=debug                  # debug | info | warn | error

# ========================================
# JWT AUTH CONFIGURATION
# ========================================
JWT_SECRET=your-jwt-secret-key-min-32-chars-long
JWT_ACCESS_TTL_HOURS=24          # Время жизни access токена (часы)
JWT_REFRESH_TTL_DAYS=7           # Время жизни refresh токена (дни)

# ========================================
# SERVICE API KEYS (кто может вызывать user-service)
# ========================================
# Формат: service-name=api-key;service-name=api-key
SERVICE_API_KEYS=task-service=your-task-service-key;analytics-service=your-analytics-key;notification-service=your-notification-key

# ========================================
# POSTGRES CONFIGURATION
# ========================================
DB_HOST=localhost                # Хост PostgreSQL
DB_PORT=5432                     # Порт PostgreSQL
DB_NAME=users                    # Имя базы данных
DB_USER=postgres                 # Имя пользователя
DB_PASSWORD=your-password        # Пароль

# Connection Pool Settings
DB_MAX_CONNS=10                  # Максимальное количество соединений в пуле
DB_MIN_CONNS=2                   # Минимальное количество соединений в пуле

# Timeouts and Durations (в секундах)
DB_HEALTH_CHECK_PERIOD=60        # Период проверки здоровья соединения (секунд)
DB_MAX_CONN_LIFETIME=3600        # Максимальное время жизни соединения (секунд)
DB_MAX_CONN_IDLE_TIME=1800       # Максимальное время бездействия соединения (секунд)
DB_CONNECT_TIMEOUT=5             # Таймаут подключения к БД (секунд)

# ========================================
# REDIS CONFIGURATION (CACHE)
# ========================================

# Connection
REDIS_CACHE_HOST=localhost       # Хост Redis для кэша
REDIS_CACHE_PORT=6379            # Порт Redis для кэша
REDIS_CACHE_PASSWORD=            # Пароль (оставьте пустым, если нет)
REDIS_CACHE_DB=0                 # Номер базы данных (0-15)

# Connection Pool
REDIS_CACHE_POOL_SIZE=100        # Максимальное количество соединений в пуле
REDIS_CACHE_MIN_IDLE_CONNS=20    # Минимальное количество idle соединений

# Timeouts
REDIS_CACHE_DIAL_TIMEOUT=5s      # Таймаут подключения к Redis
REDIS_CACHE_READ_TIMEOUT=3s      # Таймаут чтения ответа
REDIS_CACHE_WRITE_TIMEOUT=3s     # Таймаут отправки команды
REDIS_CACHE_IDLE_TIMEOUT=5m      # Закрыть idle соединение через указанное время
REDIS_CACHE_POOL_TIMEOUT=4m      # Таймаут ожидания свободного соединения
REDIS_CACHE_MAX_CON_AGE=30m      # Максимальное время жизни соединения в пуле
REDIS_CACHE_MAX_RETRIES=2        # Количество повторных попыток при временных сбоях
REDIS_CACHE_MIN_RETRY_BACKOFF_MS=100ms   # Начальная задержка перед повтором
REDIS_CACHE_MAX_RETRY_BACKOFF_MS=1000ms  # Максимальная задержка перед повтором

# ========================================
# REDIS CONFIGURATION (BLACKLIST)
# ========================================
# Используется для хранения отозванных JWT токенов

# Connection
REDIS_BLACKLIST_HOST=localhost   # Хост Redis для blacklist
REDIS_BLACKLIST_PORT=6380        # Порт Redis для blacklist (рекомендуется использовать другой порт)
REDIS_BLACKLIST_PASSWORD=        # Пароль (оставьте пустым, если нет)
REDIS_BLACKLIST_DB=0             # Номер базы данных (0-15)

# Connection Pool
REDIS_BLACKLIST_POOL_SIZE=50     # Максимальное количество соединений в пуле
REDIS_BLACKLIST_MIN_IDLE_CONNS=10 # Минимальное количество idle соединений

# Timeouts
REDIS_BLACKLIST_DIAL_TIMEOUT=5s  # Таймаут подключения к Redis
REDIS_BLACKLIST_READ_TIMEOUT=3s  # Таймаут чтения ответа
REDIS_BLACKLIST_WRITE_TIMEOUT=3s # Таймаут отправки команды
REDIS_BLACKLIST_IDLE_TIMEOUT=5m  # Закрыть idle соединение через указанное время
REDIS_BLACKLIST_POOL_TIMEOUT=4m  # Таймаут ожидания свободного соединения
REDIS_BLACKLIST_MAX_CON_AGE=30m  # Максимальное время жизни соединения в пуле
REDIS_BLACKLIST_MAX_RETRIES=2    # Количество повторных попыток при временных сбоях
REDIS_BLACKLIST_MIN_RETRY_BACKOFF_MS=100ms  # Начальная задержка перед повтором
REDIS_BLACKLIST_MAX_RETRY_BACKOFF_MS=1000ms # Максимальная задержка перед повтором

# ========================================
# BCRYPT
# ========================================
BCRYPT_COST=10                   # Стоимость хеширования паролей (4-31, рекомендуется 10-12)

# ========================================
# RABBITMQ
# ========================================
RABBITMQ_HOST=localhost          # Хост RabbitMQ
RABBITMQ_PORT=5672               # Порт RabbitMQ
RABBITMQ_USER=guest              # Имя пользователя
RABBITMQ_PASSWORD=guest          # Пароль
# Полный URL (генерируется автоматически из host, port, user, password)
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:${RABBITMQ_PORT}/

# ========================================
# OPTIONAL: Individual Service API Keys
# ========================================
# Альтернативный способ задания API ключей для каждого сервиса
TASK_SERVICE_API_KEY="your-task-service-secret-key"
ANALYTICS_SERVICE_API_KEY="your-analytics-service-secret-key"
NOTIFICATION_SERVICE_API_KEY="your-notification-service-secret-key"